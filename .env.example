# Non-secret hosted sandbox configuration. Fill credentials privately in Render.
NODE_ENV=production
NODE_VERSION=24.11.1
DATA_DIR=/var/data/brackish-roots
PUBLIC_SITE_URL=https://brackishroots.com
SQUARE_ENVIRONMENT=sandbox
MAIL_DISABLED=true
PRINT_LOCAL_ENABLED=false

# Required private values (intentionally empty)
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_URL=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=brackishroots@gmail.com
SMTP_PASS=
EMAIL_FROM=Brackish Roots <brackishroots@gmail.com>
EMAIL_OWNER=brackishroots@gmail.com
